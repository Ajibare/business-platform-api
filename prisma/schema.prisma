generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  INVENTORY_STAFF
  READ_ONLY
}

enum MovementType {
  OPENING
  RECEIPT
  ISSUE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  DAMAGE
  EXPIRED
  ADJUSTMENT
  REVERSAL
}

model Organization {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  timezone        String          @default("Africa/Lagos")
  currency        String          @default("NGN")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  memberships     Membership[]
  products        Product[]
  batches         Batch[]
  movements       StockMovement[]
  batchBalances   BatchBalance[]
  suppliers       Supplier[]
  receipts        StockReceipt[]
}

model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  phone        String?       @unique
  passwordHash String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships  Membership[]
}

model Membership {
  organizationId String
  userId         String
  role           Role          @default(READ_ONLY)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@id([organizationId, userId])
  @@index([userId, active])
}

model Product {
  id               String             @id @default(cuid())
  organizationId   String
  name             String
  normalizedName   String
  brand            String?
  strength         String?
  dosageForm       String?
  packSize         String?
  unit             String
  reorderThreshold Decimal?          @db.Decimal(14, 3)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id])
  batches          Batch[]
  receiptLines     StockReceiptLine[]

  @@index([organizationId, normalizedName])
}

model Batch {
  id             String         @id @default(cuid())
  organizationId String
  productId      String
  batchNumber    String?
  expiryDate     DateTime?
  unit           String
  unitCost       Decimal?       @db.Decimal(14, 2)
  sellingPrice   Decimal?       @db.Decimal(14, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  balance         BatchBalance?
  movements       StockMovement[]

  @@index([organizationId, expiryDate])
  @@index([organizationId, productId])
}

model StockMovement {
  id              String       @id @default(cuid())
  organizationId  String
  batchId         String
  type            MovementType
  quantityDelta   Decimal      @db.Decimal(14, 3)
  reason          String?
  actorId         String?
  idempotencyKey  String
  reversalOfId    String?
  occurredAt      DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id])
  batch           Batch        @relation(fields: [batchId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, batchId, occurredAt])
}

model BatchBalance {
  id             String       @id @default(cuid())
  organizationId String
  batchId        String       @unique
  quantity       Decimal      @db.Decimal(14, 3)
  version        Int          @default(1)
  updatedAt      DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])
  batch          Batch        @relation(fields: [batchId], references: [id])

  @@index([organizationId])
}

model Supplier {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  receipts       StockReceipt[]

  @@index([organizationId, name])
}

model StockReceipt {
  id                String             @id @default(cuid())
  organizationId    String
  supplierId        String?
  externalReference String?
  status            String             @default("DRAFT")
  receivedAt        DateTime           @default(now())
  actorId           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id])
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  lines             StockReceiptLine[]

  @@index([organizationId, status])
  @@index([organizationId, receivedAt])
}

model StockReceiptLine {
  id           String       @id @default(cuid())
  receiptId    String
  productId    String
  batchNumber  String?
  expiryDate   DateTime?
  unitCost     Decimal?     @db.Decimal(14, 2)
  sellingPrice Decimal?     @db.Decimal(14, 2)
  quantity     Decimal      @db.Decimal(14, 3)
  receipt      StockReceipt @relation(fields: [receiptId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@index([productId])
}

model StockCount {
  id              String   @id @default(cuid())
  organizationId  String
  status          String   @default("DRAFT")
  scope           String   @default("ALL")
  startedAt       DateTime @default(now())
  closedAt        DateTime?
  counterId       String?
  approverId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lines           StockCountLine[]

  @@index([organizationId, status])
}

model StockCountLine {
  id               String  @id @default(cuid())
  countId          String
  batchId          String?
  productId        String?
  recordedQuantity Decimal? @db.Decimal(14, 3)
  countedQuantity Decimal  @db.Decimal(14, 3)
  variance         Decimal? @db.Decimal(14, 3)
  note             String?
  versionAtCount  DateTime @default(now())
  count           StockCount @relation(fields: [countId], references: [id])

  @@index([countId])
}
