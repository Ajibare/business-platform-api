generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection used by the running API (Supabase transaction pooler in
  // production, a direct connection locally).
  url      = env("DATABASE_URL")
  // Unpooled connection used by `prisma migrate` and `prisma db`, which need a
  // session that can hold advisory locks and run DDL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  BRANCH_MANAGER
  PHARMACIST
  INVENTORY_OFFICER
  CASHIER
  // Legacy workspace roles. They stay in the enum because existing memberships
  // carry them; the permission catalogue gives each one a read/write set so an
  // upgraded workspace behaves exactly as it did before branches existed.
  MANAGER
  INVENTORY_STAFF
  READ_ONLY
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  SUSPENDED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

/** Per-member grant or denial that wins over the role's default set. */
enum PermissionEffect {
  GRANT
  DENY
}

enum TransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_TRANSIT
  RECEIVED
  REJECTED
  CANCELLED
}

/// Where a member stands inside one organisation. Access ends for SUSPENDED
/// and DEACTIVATED members without touching the global User account.
enum MembershipStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum MovementType {
  OPENING
  RECEIPT
  ISSUE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  DAMAGE
  EXPIRED
  ADJUSTMENT
  REVERSAL
  TRANSFER_OUT
  TRANSFER_IN
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

model Organization {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  timezone        String          @default("Africa/Lagos")
  currency        String          @default("NGN")
  phone           String?
  address         String?
  outletProfile   String?
  nearExpiryWarningDays Int       @default(90)
  defaultUnit     String?
  defaultMinStockLevel Decimal?   @db.Decimal(14, 3)
  /// When true, a transfer waits in PENDING_APPROVAL before stock moves.
  requireTransferApproval Boolean @default(false)
  onboardingCompletedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  memberships     Membership[]
  branches        Branch[]
  rolePermissions RolePermission[]
  memberPermissions MemberPermission[]
  transfers       StockTransfer[]
  products        Product[]
  batches         Batch[]
  movements       StockMovement[]
  batchBalances   BatchBalance[]
  suppliers       Supplier[]
  receipts        StockReceipt[]
  notifications   Notification[]
  notificationPrefs NotificationPreference?
  recipients      NotificationRecipient[]
  deliveries      NotificationDelivery[]
  auditLogs       AuditLog[]
  importJobs      ImportJob[]
  invitations     StaffInvitation[]
  onboarding      OnboardingProgress?
  sales           Sale[]
  saleReturns     SaleReturn[]
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String?       @unique
  phone        String?       @unique
  passwordHash String?
  status       UserStatus    @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  failedLoginAttempts Int      @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  passwordChangedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships  Membership[]
  sessions     AuthSession[]
  passwordResets PasswordReset[]
  branchAssignments BranchStaff[]
  managedBranches Branch[]    @relation("BranchManager")
  permissionOverrides MemberPermission[]
}

model Membership {
  organizationId String
  userId         String
  role           Role          @default(READ_ONLY)
  /// Kept in step with `status` for the guards written before branches existed.
  active         Boolean       @default(true)
  status         MembershipStatus @default(ACTIVE)
  /// Why access was suspended or removed, shown on the staff detail page.
  statusReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@id([organizationId, userId])
  @@index([userId, active])
}

/**
 * A location under one pharmacy organisation. The medicine catalogue is shared
 * across branches; batches, balances, movements and sales belong to exactly one.
 */
model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  /// Short human code, unique inside the organisation (for example MAIN, LEK-01).
  code           String
  address        String?
  phone          String?
  email          String?
  managerUserId  String?
  status         BranchStatus @default(ACTIVE)
  /// The branch every legacy record was moved to; a workspace always has one.
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  manager        User?        @relation("BranchManager", fields: [managerUserId], references: [id])
  staff          BranchStaff[]
  batches        Batch[]
  movements      StockMovement[]
  sales          Sale[]
  receipts       StockReceipt[]
  counts         StockCount[]
  notifications  Notification[]
  recipients     NotificationRecipient[]
  auditLogs      AuditLog[]
  importJobs     ImportJob[]
  invitations    InvitationBranch[]
  transfersOut   StockTransfer[] @relation("TransferSource")
  transfersIn    StockTransfer[] @relation("TransferDestination")

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

/** Which staff members may work in a branch. */
model BranchStaff {
  branchId  String
  userId    String
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([branchId, userId])
  @@index([userId])
}

/** Editable defaults: what a role may do in this organisation. */
model RolePermission {
  organizationId String
  role           Role
  permission     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, role, permission])
  @@index([organizationId, role])
}

/** Per-member exception to the role defaults. */
model MemberPermission {
  organizationId String
  userId         String
  permission     String
  effect         PermissionEffect @default(GRANT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@id([organizationId, userId, permission])
  @@index([userId])
}

model Product {
  id               String             @id @default(cuid())
  organizationId   String
  name             String
  normalizedName   String
  genericName      String?
  category         String?
  brand            String?
  strength         String?
  dosageForm       String?
  packSize         String?
  unit             String
  barcode          String?
  /// Pharmacy internal stock keeping unit. Optional and unique per pharmacy.
  sku              String?
  description      String?
  reorderThreshold Decimal?          @db.Decimal(14, 3)
  active           Boolean           @default(true)
  /// Seeded by the onboarding "explore with sample data" option so the UI can label it.
  isSample         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id])
  batches          Batch[]
  receiptLines     StockReceiptLine[]
  saleLines        SaleLine[]
  transferLines    StockTransferLine[]

  @@unique([organizationId, barcode])
  @@unique([organizationId, sku])
  @@index([organizationId, normalizedName])
  @@index([organizationId, barcode])
}

model Batch {
  id             String         @id @default(cuid())
  organizationId String
  productId      String
  /// Stock sits in exactly one branch. The same medicine can hold a batch per
  /// branch, and no query may add quantities across branches.
  branchId       String
  batchNumber    String?
  expiryDate     DateTime?
  unit           String
  unitCost       Decimal?       @db.Decimal(14, 2)
  sellingPrice   Decimal?       @db.Decimal(14, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  branch          Branch         @relation(fields: [branchId], references: [id])
  balance         BatchBalance?
  movements       StockMovement[]
  saleLines       SaleLine[]
  transferLinesOut StockTransferLine[] @relation("TransferSourceBatch")
  transferLinesIn  StockTransferLine[] @relation("TransferDestinationBatch")

  @@index([organizationId, expiryDate])
  @@index([organizationId, productId])
  @@index([branchId, productId, expiryDate])
  // Expiry alert, near-expiry and expired queries filter organisation + branch
  // scope and then range/sort on expiryDate; the product-scoped index above
  // cannot serve that range because productId sits between the two columns.
  @@index([organizationId, branchId, expiryDate])
}

model StockMovement {
  id              String       @id @default(cuid())
  organizationId  String
  branchId        String
  batchId         String
  type            MovementType
  quantityDelta   Decimal      @db.Decimal(14, 3)
  /// Balance before and after the movement, captured atomically with the change.
  previousQuantity Decimal?    @db.Decimal(14, 3)
  newQuantity     Decimal?     @db.Decimal(14, 3)
  reason          String?
  actorId         String?
  idempotencyKey  String
  reversalOfId    String?
  occurredAt      DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id])
  branch          Branch       @relation(fields: [branchId], references: [id])
  batch           Batch        @relation(fields: [batchId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, batchId, occurredAt])
  @@index([organizationId, branchId, occurredAt])
}

model BatchBalance {
  id             String       @id @default(cuid())
  organizationId String
  batchId        String       @unique
  quantity       Decimal      @db.Decimal(14, 3)
  version        Int          @default(1)
  updatedAt      DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])
  batch          Batch        @relation(fields: [batchId], references: [id])

  @@index([organizationId])
}

model Supplier {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  receipts       StockReceipt[]

  @@index([organizationId, name])
}

model StockReceipt {
  id                String             @id @default(cuid())
  organizationId    String
  branchId          String
  supplierId        String?
  externalReference String?
  status            String             @default("DRAFT")
  receivedAt        DateTime           @default(now())
  actorId           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id])
  branch            Branch             @relation(fields: [branchId], references: [id])
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  lines             StockReceiptLine[]

  @@index([organizationId, status])
  @@index([organizationId, receivedAt])
  @@index([organizationId, branchId, receivedAt])
}

model StockReceiptLine {
  id           String       @id @default(cuid())
  receiptId    String
  productId    String
  batchNumber  String?
  expiryDate   DateTime?
  unitCost     Decimal?     @db.Decimal(14, 2)
  sellingPrice Decimal?     @db.Decimal(14, 2)
  quantity     Decimal      @db.Decimal(14, 3)
  receipt      StockReceipt @relation(fields: [receiptId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@index([productId])
}

model StockCount {
  id              String   @id @default(cuid())
  organizationId  String
  branchId        String
  status          String   @default("DRAFT")
  scope           String   @default("ALL")
  startedAt       DateTime @default(now())
  closedAt        DateTime?
  counterId       String?
  approverId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  branch          Branch   @relation(fields: [branchId], references: [id])
  lines           StockCountLine[]

  @@index([organizationId, status])
  @@index([organizationId, branchId, startedAt])
}

model StockCountLine {
  id               String  @id @default(cuid())
  countId          String
  batchId          String?
  productId        String?
  recordedQuantity Decimal? @db.Decimal(14, 3)
  countedQuantity Decimal  @db.Decimal(14, 3)
  variance         Decimal? @db.Decimal(14, 3)
  note             String?
  versionAtCount  DateTime @default(now())
  count           StockCount @relation(fields: [countId], references: [id])

  @@index([countId])
}

model NotificationPreference {
  organizationId          String   @id
  inAppEnabled            Boolean  @default(true)
  emailEnabled            Boolean  @default(false)
  expiryRemindersEnabled  Boolean  @default(true)
  saleNotificationsEnabled Boolean @default(false)
  reminderLeadDays        Int      @default(90)
  /// Deprecated: milestone reminders (90/60/30/7/0 days) ignore the interval.
  reminderIntervalDays    Int      @default(7)
  dailyReportEnabled      Boolean  @default(false)
  /// When true the daily report is produced per branch instead of consolidated.
  dailyReportPerBranch    Boolean  @default(false)
  /// Local delivery time in HH:mm, evaluated in `dailyReportTimezone`.
  dailyReportTime         String   @default("20:00")
  /// Reporting timezone; falls back to the organisation timezone when null.
  dailyReportTimezone     String?
  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())
  organization            Organization @relation(fields: [organizationId], references: [id])
}

model NotificationRecipient {
  id             String   @id @default(cuid())
  organizationId String
  /// Optional: limits this recipient to one branch's alerts.
  branchId       String?
  email          String
  name           String?
  active         Boolean  @default(true)
  receivesExpiry Boolean  @default(true)
  receivesSales  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  branch         Branch?      @relation(fields: [branchId], references: [id])

  @@unique([organizationId, email])
  @@index([organizationId, active])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  /// The branch the alert belongs to; null for organisation-wide notices.
  branchId       String?
  type           String
  title          String
  body           String
  severity       String   @default("info")
  productId      String?
  batchId        String?
  dedupeKey      String
  metadata       Json?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  branch         Branch?      @relation(fields: [branchId], references: [id])
  reads          NotificationRead[]
  deliveries     NotificationDelivery[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
}

model NotificationRead {
  notificationId String
  userId         String
  readAt         DateTime @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id])

  @@id([notificationId, userId])
  @@index([userId])
}

model NotificationDelivery {
  id             String   @id @default(cuid())
  organizationId String
  notificationId String
  recipient      String
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  lastError      String?
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  notification   Notification @relation(fields: [notificationId], references: [id])

  @@unique([notificationId, recipient])
  @@index([organizationId, status])
  @@index([status, nextAttemptAt])
}

model Sale {
  id              String     @id @default(cuid())
  organizationId  String
  /// Every sale is booked against the branch that sold it.
  branchId        String
  reference       String
  status          SaleStatus @default(COMPLETED)
  occurredAt      DateTime   @default(now())
  actorId         String?
  customerName    String?
  note            String?
  idempotencyKey  String
  /// Sum of line quantity x unit price before discounts.
  subtotal        Decimal    @db.Decimal(14, 2)
  discountTotal   Decimal    @default(0) @db.Decimal(14, 2)
  /// Sum of refunds recorded against the sale.
  refundTotal     Decimal    @default(0) @db.Decimal(14, 2)
  /// Subtotal minus discounts. Sales revenue, never profit.
  revenue         Decimal    @db.Decimal(14, 2)
  /// Sum of known batch costs. Null when a line has no recorded cost.
  costTotal       Decimal?   @db.Decimal(14, 2)
  /// Revenue minus refunds minus cost. Null when cost is incomplete.
  grossProfit     Decimal?   @db.Decimal(14, 2)
  unitCount       Decimal    @default(0) @db.Decimal(14, 3)
  voidedAt        DateTime?
  voidedById      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])
  branch          Branch       @relation(fields: [branchId], references: [id])
  lines           SaleLine[]
  returns         SaleReturn[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, occurredAt])
  @@index([organizationId, status, occurredAt])
  @@index([organizationId, branchId, occurredAt])
}

model SaleLine {
  id               String   @id @default(cuid())
  saleId           String
  productId        String
  batchId          String
  quantity         Decimal  @db.Decimal(14, 3)
  returnedQuantity Decimal  @default(0) @db.Decimal(14, 3)
  unitPrice        Decimal  @db.Decimal(14, 2)
  discount         Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal        Decimal  @db.Decimal(14, 2)
  unitCost         Decimal? @db.Decimal(14, 2)
  costTotal        Decimal? @db.Decimal(14, 2)
  sale             Sale     @relation(fields: [saleId], references: [id])
  product          Product  @relation(fields: [productId], references: [id])
  batch            Batch    @relation(fields: [batchId], references: [id])
  returnLines      SaleReturnLine[]

  @@index([saleId])
  @@index([productId])
  @@index([batchId])
}

model SaleReturn {
  id             String   @id @default(cuid())
  organizationId String
  saleId         String
  amount         Decimal  @db.Decimal(14, 2)
  quantity       Decimal  @db.Decimal(14, 3)
  reason         String?
  actorId        String?
  idempotencyKey String
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  sale           Sale     @relation(fields: [saleId], references: [id])
  lines          SaleReturnLine[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, occurredAt])
  @@index([saleId])
}

model SaleReturnLine {
  id         String   @id @default(cuid())
  returnId   String
  saleLineId String
  quantity   Decimal  @db.Decimal(14, 3)
  amount     Decimal  @db.Decimal(14, 2)
  return     SaleReturn @relation(fields: [returnId], references: [id])
  saleLine   SaleLine @relation(fields: [saleLineId], references: [id])

  @@index([returnId])
  @@index([saleLineId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  branch         Branch?  @relation(fields: [branchId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, branchId, createdAt])
  // The staff activity tab lists one member's entries, newest first.
  @@index([organizationId, actorId, createdAt])
}

model ImportJob {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  type           String
  filename       String
  status         String   @default("VALIDATED")
  totalRows      Int      @default(0)
  validRows      Int      @default(0)
  invalidRows    Int      @default(0)
  duplicateRows  Int      @default(0)
  importedRows   Int      @default(0)
  failedRows     Int      @default(0)
  createdById    String?
  summary        Json?
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  branch         Branch?  @relation(fields: [branchId], references: [id])
  rows           ImportJobRow[]

  @@index([organizationId, createdAt])
}

model ImportJobRow {
  id        String   @id @default(cuid())
  jobId     String
  rowNumber Int
  status    String
  data      Json
  errors    Json
  productId String?
  batchId   String?
  job       ImportJob @relation(fields: [jobId], references: [id])

  @@index([jobId, rowNumber])
}

model AuthSession {
  id                  String    @id @default(cuid())
  userId              String
  organisationId      String?
  refreshTokenHash    String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime  @default(now())
  lastUsedAt          DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PendingRegistration {
  id                   String   @id @default(cuid())
  name                 String
  email                String   @unique
  phone                String?
  passwordHash         String
  termsAcceptedAt      DateTime
  verificationCodeHash String
  codeExpiresAt        DateTime
  attempts             Int      @default(0)
  resendCount          Int      @default(0)
  lastSentAt           DateTime @default(now())
  verifiedAt           DateTime?
  userId               String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([phone])
  @@index([codeExpiresAt])
}

model PasswordReset {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId, consumedAt])
}

model StaffInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String?
  phone          String?
  role           Role
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique
  expiresAt      DateTime
  invitedById    String
  acceptedById   String?
  acceptedAt     DateTime?
  /// How many times the invitation email has been sent.
  resendCount    Int              @default(0)
  lastSentAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  branches       InvitationBranch[]

  @@index([organizationId, status])
  @@index([email])
}

model OnboardingProgress {
  organizationId String       @id
  currentStep    Int          @default(1)
  completedSteps Json         @default("[]")
  status         String       @default("IN_PROGRESS")
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
}

/**
 * A request to move stock from one branch to another. Quantities only ever
 * leave the source when the transfer is dispatched and enter the destination
 * when it is received, so the same units are never counted twice.
 */
model StockTransfer {
  id             String         @id @default(cuid())
  organizationId String
  reference      String
  fromBranchId   String
  toBranchId     String
  status         TransferStatus @default(DRAFT)
  note           String?
  requestedById  String?
  approvedById   String?
  dispatchedById String?
  receivedById   String?
  rejectedById   String?
  rejectedReason String?
  approvedAt     DateTime?
  dispatchedAt   DateTime?
  receivedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  fromBranch     Branch         @relation("TransferSource", fields: [fromBranchId], references: [id])
  toBranch       Branch         @relation("TransferDestination", fields: [toBranchId], references: [id])
  lines          StockTransferLine[]

  @@unique([organizationId, reference])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, fromBranchId, createdAt])
  @@index([organizationId, toBranchId, createdAt])
}

model StockTransferLine {
  id                 String   @id @default(cuid())
  transferId         String
  productId          String
  sourceBatchId      String
  /// The batch created at the destination when the transfer is dispatched.
  destinationBatchId String?
  quantity           Decimal  @db.Decimal(14, 3)
  receivedQuantity   Decimal  @default(0) @db.Decimal(14, 3)
  /// Units that arrived short or damaged, excluded from the received count.
  damagedQuantity    Decimal  @default(0) @db.Decimal(14, 3)
  transfer           StockTransfer @relation(fields: [transferId], references: [id])
  product            Product       @relation(fields: [productId], references: [id])
  sourceBatch        Batch         @relation("TransferSourceBatch", fields: [sourceBatchId], references: [id])
  destinationBatch   Batch?        @relation("TransferDestinationBatch", fields: [destinationBatchId], references: [id])

  @@index([transferId])
  @@index([sourceBatchId])
  @@index([destinationBatchId])
}

/** Branch choices attached to a pending staff invitation. */
model InvitationBranch {
  invitationId String
  branchId     String
  invitation   StaffInvitation @relation(fields: [invitationId], references: [id])
  branch       Branch         @relation(fields: [branchId], references: [id])

  @@id([invitationId, branchId])
  @@index([branchId])
}
