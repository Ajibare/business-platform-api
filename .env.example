NODE_ENV=development
PORT=3001

# Database.
# DATABASE_URL is the pooled connection the running API uses. DIRECT_URL is the
# unpooled connection Prisma uses for migrations and schema commands. Locally
# both point at the same PostgreSQL instance.
#
# Supabase: Dashboard -> Project Settings -> Database -> Connection string.
#   DATABASE_URL = "Transaction pooler" string (port 6543). Append the Prisma
#                  parameters: ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = "Direct connection" string (port 5432), or the "Session
#                  pooler" string if your network has no IPv6 route to the
#                  direct host. Migrations cannot run through the transaction
#                  pooler.
# Never commit a real connection string; keep them in .env only.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/business_platform?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/business_platform?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info


# Public URL of the web app. Used to build verification, reset and invitation links.
APP_WEB_URL=http://localhost:3000

# Authentication. The pepper keys every stored verification code, reset token and
# refresh token hash. Changing it invalidates them all, so set it once per environment.
AUTH_SECRET_PEPPER=change-me-in-production
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_BCRYPT_ROUNDS=12
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_VERIFICATION_CODE_TTL_MINUTES=15
AUTH_VERIFICATION_MAX_ATTEMPTS=5
AUTH_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
AUTH_VERIFICATION_MAX_RESENDS=6
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_INVITATION_TTL_DAYS=7

# Notifications. Set the scan interval to 0 to disable the in-process scheduler.
NOTIFICATION_SCAN_INTERVAL_MINUTES=60
NOTIFICATION_SCAN_INITIAL_DELAY_SECONDS=20

# Email delivery. `log` records attempts without sending; `http` posts to EMAIL_HTTP_URL.
# The `http` transport expects a Resend-compatible endpoint that accepts
# { from, to, subject, text } with a bearer key. EMAIL_FROM must be on a verified
# domain; `onboarding@resend.dev` only reaches the Resend account owner.
EMAIL_TRANSPORT=log
EMAIL_FROM="Pharmacy Stock Intelligence <onboarding@resend.dev>"
EMAIL_HTTP_URL=https://api.resend.com/emails
EMAIL_HTTP_API_KEY=
EMAIL_MAX_ATTEMPTS=5

# Bulk import limits
IMPORT_MAX_ROWS=2000
IMPORT_MAX_FILE_BYTES=5000000
